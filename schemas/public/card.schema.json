{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card público",
  "type": "object",
  "required": [
    "id",
    "cliente_id",
    "titulo",
    "cidade",
    "finalidade",
    "preco"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "finalidade": {
      "type": "string"
    },
    "tipo": {
      "type": "string"
    },
    "preco": {
      "type": "number"
    },
    "area": {
      "type": "number"
    },
    "quartos": {
      "type": "integer"
    },
    "banheiros": {
      "type": "integer"
    },
    "vagas": {
      "type": "integer"
    },
    "foto": {
      "type": "string"
    },
    "preco_venda": {
      "type": "number",
      "minimum": 0
    },
    "preco_aluguel": {
      "type": "number",
      "minimum": 0
    },
    "area_util": {
      "type": "number",
      "minimum": 0
    },
    "area_terreno": {
      "type": "number",
      "minimum": 0
    },
    "suites": {
      "type": "integer",
      "minimum": 0
    },
    "andar": {
      "type": "integer",
      "minimum": 0
    },
    "andares": {
      "type": "integer",
      "minimum": 0
    },
    "ano_construcao": {
      "type": "integer",
      "minimum": 0
    },
    "subtipo": {
      "type": "string",
      "maxLength": 80
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
