{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imóvel público completo",
  "type": "object",
  "required": [
    "id",
    "cliente_id",
    "titulo",
    "cidade",
    "finalidade",
    "tipo",
    "preco",
    "fotos"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "finalidade": {
      "enum": [
        "venda",
        "aluguel"
      ]
    },
    "tipo": {
      "type": "string"
    },
    "preco": {
      "type": "number"
    },
    "area": {
      "type": "number"
    },
    "quartos": {
      "type": "integer"
    },
    "banheiros": {
      "type": "integer"
    },
    "vagas": {
      "type": "integer"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "image",
              "video"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "primary": {
            "type": "boolean"
          },
          "caption": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "contact_info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "virtual_tour_link": {
      "type": "string",
      "format": "uri"
    },
    "area_apresentacao": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "m²",
            "ha"
          ]
        }
      },
      "additionalProperties": false
    },
    "preco_venda": {
      "type": "number",
      "minimum": 0
    },
    "preco_aluguel": {
      "type": "number",
      "minimum": 0
    },
    "area_util": {
      "type": "number",
      "minimum": 0
    },
    "area_terreno": {
      "type": "number",
      "minimum": 0
    },
    "suites": {
      "type": "integer",
      "minimum": 0
    },
    "andar": {
      "type": "integer",
      "minimum": 0
    },
    "andares": {
      "type": "integer",
      "minimum": 0
    },
    "ano_construcao": {
      "type": "integer",
      "minimum": 0
    },
    "subtipo": {
      "type": "string",
      "maxLength": 80
    }
  },
  "additionalProperties": false
}
